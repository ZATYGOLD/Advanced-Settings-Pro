      			<Group>Game</Group>
      			<ConfigurationId>IndependentCountKey</ConfigurationId>
      			<Value>ZG_MORE_INDEPENDENTS</Value>
    		</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="less-independents">
    		<ConfigurationValueMatches>
      			<Group>Game</Group>
      			<ConfigurationId>IndependentCountKey</ConfigurationId>
      			<Value>ZG_LESS_INDEPENDENTS</Value>
    		</ConfigurationValueMatches>
