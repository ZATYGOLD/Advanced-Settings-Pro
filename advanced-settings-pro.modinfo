	<ActionGroups>

<!--************************* SETTINGS: TEXT AND SETUP PARAMETERS ***************-->

		<ActionGroup id="zg-options-settings-shell" scope="shell" criteria="always">
			<Properties>
				<LoadOrder>500</LoadOrder>
			</Properties>
			<Actions>
				<UIScripts>
					<Item>ui/zg-asp-guard.js</Item>
				</UIScripts>
				<UpdateText>
					<Item>text/en_us/ui-shell-text.xml</Item>
					<Item>text/natural-wonder-names.xml</Item>
					<Item>l10n/de_DE_Text.xml</Item>
					<Item>l10n/es_ES_Text.xml</Item>
					<Item>l10n/fr_FR_Text.xml</Item>
					<Item>l10n/it_IT_Text.xml</Item>
					<Item>l10n/ja_JP_Text.xml</Item>
					<Item>l10n/ko_KR_Text.xml</Item>
					<Item>l10n/pl_PL_Text.xml</Item>
					<Item>l10n/pt_BR_Text.xml</Item>
					<Item>l10n/ru_RU_Text.xml</Item>
					<Item>l10n/zh_Hans_CN_Text.xml</Item>
					<Item>l10n/zh_Hant_HK_Text.xml</Item>
				</UpdateText>
				<UpdateDatabase>
					<Item>config/setup-parameters.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="zg-options-settings-game" scope="game" criteria="always">
			<Properties>
				<LoadOrder>500</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
					<Item>text/en_us/ui-shell-text.xml</Item>
					<Item>text/natural-wonder-names.xml</Item>
					<Item>l10n/de_DE_Text.xml</Item>
					<Item>l10n/es_ES_Text.xml</Item>
					<Item>l10n/fr_FR_Text.xml</Item>
					<Item>l10n/it_IT_Text.xml</Item>
					<Item>l10n/ja_JP_Text.xml</Item>
					<Item>l10n/ko_KR_Text.xml</Item>
					<Item>l10n/pl_PL_Text.xml</Item>
					<Item>l10n/pt_BR_Text.xml</Item>
					<Item>l10n/ru_RU_Text.xml</Item>
					<Item>l10n/zh_Hans_CN_Text.xml</Item>
					<Item>l10n/zh_Hant_HK_Text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>

<!--************************* SETTINGS: SETTLER MOVEMENT ************************-->

		<ActionGroup id="zg-slow-settlers" scope="game" criteria="slow-settlers">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/units/settler-embark-modifiers.sql</Item>
					<Item>data/units/settler-speed-slow.sql</Item>
					<Item>data/units/settler-embark-slow.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="zg-fast-settlers" scope="game" criteria="fast-settlers">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/units/settler-embark-modifiers.sql</Item>
					<Item>data/units/settler-speed-fast.sql</Item>
					<Item>data/units/settler-embark-fast.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

