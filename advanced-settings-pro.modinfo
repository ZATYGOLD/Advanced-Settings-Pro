<?xml version="1.0" encoding="utf-8"?>
<Mod id="AdvancedSettingsPro" version="00800" xmlns="ModInfo">
	<Properties>
		<Name>LOC_MODULE_ZG_ADVANCED_SETTINGS_PRO_NAME</Name>
		<Description>LOC_MODULE_ZG_ADVANCED_SETTINGS_PRO_DESCRIPTION</Description>
		<Authors>Zatygold</Authors>
		<Version>0.8.0</Version>
		<Package>Mod</Package>
		<ShowInBrowser>1</ShowInBrowser>
		<EnabledByDefault>1</EnabledByDefault>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
		<Mod id="age-antiquity" title="LOC_MODULE_AGE_ANTIQUITY_NAME"/>
		<Mod id="age-exploration" title="LOC_MODULE_AGE_EXPLORATION_NAME"/>
		<Mod id="age-modern" title="LOC_MODULE_AGE_MODERN_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet/>
		</Criteria>

<!--************************* CRITERIA: SETTLER MOVEMENT ************************-->

		<Criteria id="slow-settlers">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SettlerMovementKey</ConfigurationId>
				<Value>ZG_SETTLER_MOVES_SLOW</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="fast-settlers">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SettlerMovementKey</ConfigurationId>
				<Value>ZG_SETTLER_MOVES_FAST</Value>
			</ConfigurationValueMatches>
		</Criteria>

<!--************************* CRITERIA: TREASURE CONVOY *************************-->

		<Criteria id="slow-treasure">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>TreasureMovementKey</ConfigurationId>
				<Value>ZG_TREASURE_MOVES_SLOW</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="fast-treasure">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>TreasureMovementKey</ConfigurationId>
