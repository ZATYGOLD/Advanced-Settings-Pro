<!--************************* SETTINGS: TEXT AND SETUP PARAMETERS ***************-->

		<ActionGroup id="zg-options-settings-shell" scope="shell" criteria="always">
			<Properties>
				<LoadOrder>500</LoadOrder>
			</Properties>
			<Actions>
				<UIScripts>
					<Item>ui/zg-asp-guard.js</Item>
					<Item>ui/zg-setup-rules.js</Item>
				</UIScripts>
				<UpdateText>
					<Item>text/en_us/ui-shell-text.xml</Item>
					<Item>text/natural-wonder-names.xml</Item>
					<Item>l10n/de_DE_Text.xml</Item>
					<Item>l10n/es_ES_Text.xml</Item>
					<Item>l10n/fr_FR_Text.xml</Item>
					<Item>l10n/it_IT_Text.xml</Item>
					<Item>l10n/ja_JP_Text.xml</Item>
					<Item>l10n/ko_KR_Text.xml</Item>
					<Item>l10n/pl_PL_Text.xml</Item>
					<Item>l10n/pt_BR_Text.xml</Item>
					<Item>l10n/ru_RU_Text.xml</Item>
					<Item>l10n/zh_Hans_CN_Text.xml</Item>
					<Item>l10n/zh_Hant_HK_Text.xml</Item>
				</UpdateText>
				<UpdateDatabase>
					<Item>config/setup-parameters.sql</Item>
					<Item>config/map-scripts.sql</Item>
					<Item>config/game-speeds.sql</Item>
				</UpdateDatabase>
				<ImportFiles>
					<Item>maps/zg-map-rivers.js</Item>
					<Item>maps/zg-map-lakes.js</Item>
					<Item>maps/zg-continents-voronoi.js</Item>
					<Item>maps/zg-pangaea-voronoi.js</Item>
					<Item>maps/zg-fractal-voronoi.js</Item>
					<Item>maps/zg-shattered-seas-voronoi.js</Item>
					<Item>maps/zg-continents-plus.js</Item>
					<Item>maps/zg-continents.js</Item>
					<Item>maps/zg-archipelago.js</Item>
					<Item>maps/zg-fractal.js</Item>
					<Item>maps/zg-shuffle.js</Item>
					<Item>maps/zg-terra-incognita.js</Item>
					<Item>maps/zg-pangaea-plus.js</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
		<ActionGroup id="zg-options-settings-game" scope="game" criteria="always">
			<Properties>
				<LoadOrder>500</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
