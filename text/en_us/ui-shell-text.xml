	<!-- Unit Movement Descriptions -->
		<Row Tag="LOC_ZG_SETTLER_MOVEMENT_SPEED_DESCRIPTION">
			<Text>Sets the settler base movement and embarked speed.</Text>
		</Row>
		<Row Tag="LOC_ZG_SETTLER_MOVEMENT_SPEED_DESCRIPTION_SLOW">
			<Text>[BLIST]
				[LI] Slow: 2[icon:Action_Move]Base and 1[icon:Action_Move]Embarked Movement.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_SETTLER_MOVEMENT_SPEED_DESCRIPTION_DEFAULT">
			<Text>[BLIST]
				[LI] Standard: 3[icon:Action_Move]Base and 2[icon:Action_Move]Embarked Movement.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_SETTLER_MOVEMENT_SPEED_DESCRIPTION_FAST">
			<Text>[BLIST]
				[LI] Fast: 4[icon:Action_Move]Base and 3[icon:Action_Move]Embarked Movement.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_TREASURE_MOVEMENT_SPEED_DESCRIPTION">
			<Text>Sets the treasure convoy base movement and embarked speed.</Text>
		</Row>
		<Row Tag="LOC_ZG_TREASURE_MOVEMENT_SPEED_DESCRIPTION_SLOW">
			<Text>[BLIST]
				[LI] Slow: 1[icon:Action_Move]Base and Embarked Movement.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_TREASURE_MOVEMENT_SPEED_DESCRIPTION_DEFAULT">
			<Text>[BLIST]
				[LI] Standard: 2[icon:Action_Move]Base and Embarked Movement.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_TREASURE_MOVEMENT_SPEED_DESCRIPTION_FAST">
			<Text>[BLIST]
				[LI] Fast: 3[icon:Action_Move]Base and Embarked Movement.[/BLIST]
			</Text>
		</Row>

	<!-- Independent Power Descriptions -->
		<Row Tag="LOC_ZG_INDEPENDENT_COUNT_DESCRIPTION">
			<Text>Sets the initial number of [icon:INDEPENDENT_POWER]Independent Powers. Results may vary.[n]This will attempt to spawn the desired amount, but may not get the exact expected number. However, this will get as close as possible to the expected number.</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_COUNT_DESCRIPTION_NONE">
			<Text>[BLIST]
				[LI] None: 0 Independent Powers.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_COUNT_DESCRIPTION_LESS">
			<Text>[BLIST]
				[LI] Less: 2 Independent Powers per Civilization.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_COUNT_DESCRIPTION_DEFAULT">
			<Text>[BLIST]
				[LI] Standard: 3 Independent Powers per Civilization.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_COUNT_DESCRIPTION_MORE">
			<Text>[BLIST]
				[LI] More: 4 Independent Powers per Civilization.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_SPACE_DESCRIPTION">
			<Text>Sets the minimum distance for Independent Powers.
				[n] This may impact the total number of Independent Powers.
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_SPACE_DESCRIPTION_LESS">
			<Text>[BLIST]
				[LI] Antiquity: 4 Tiles.
				[LI] Exploration: 3 Tiles.
				[LI] Modern: 2 Tiles.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_SPACE_DESCRIPTION_DEFAULT">
			<Text>[BLIST]
				[LI] Antiquity: 6 Tiles.
				[LI] Exploration: 6 Tiles.
				[LI] Modern: 4 Tiles.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_SPACE_DESCRIPTION_MORE">
			<Text>[BLIST]
				[LI] Antiquity: 7 Tiles.
				[LI] Exploration: 7 Tiles.
				[LI] Modern: 5 Tiles.[/BLIST]
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_INITIAL_UNITS_COUNT_DESCRIPTION">
			<Text>Sets the initial number of an Independent Power's units.
				[n] Independent Powers always start with 1[icon:UNIT_SCOUT]Scout.
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_INITIAL_UNITS_DESCRIPTION_LESS">
			<Text>Sets the initial number of an Independent Power's units.
				[n] Independent Powers always start with 1[icon:UNIT_SCOUT]Scout.
				[n] [BLIST]
				[LI] Antiquity: 0[icon:UNIT_WARRIOR]Warriors.
				[LI] Exploration: 2[icon:UNIT_SWORDSMAN]Swordsmen.
				[LI] Modern: 3 [icon:UNIT_LINE_INFANTRY]Line Infantry.[/BLIST]
				[n] [n]The number of units will depend upon the number of land tiles available within the first ring including the village center.
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_INITIAL_UNITS_DESCRIPTION_DEFAULT">
			<Text>Sets the initial number of an Independent Power's units.
				[n] Independent Powers always start with 1[icon:UNIT_SCOUT]Scout.
				[n] [BLIST]
				[LI] Antiquity: 1[icon:UNIT_WARRIOR]Warrior.
				[LI] Exploration: 3[icon:UNIT_SWORDSMAN]Swordsmen.
				[LI] Modern: 4 [icon:UNIT_LINE_INFANTRY]Line Infantry.[/BLIST]
				[n] [n]The number of units will depend upon the number of land tiles available within the first ring including the village center.
			</Text>
		</Row>
		<Row Tag="LOC_ZG_INDEPENDENT_INITIAL_UNITS_DESCRIPTION_MORE">
			<Text>Sets the initial number of an Independent Power's units.
				[n]Independent Powers always start with 1[icon:UNIT_SCOUT]Scout.
				[n] [BLIST]
				[LI] Antiquity: 2[icon:UNIT_WARRIOR]Warriors.
				[LI] Exploration: 4[icon:UNIT_SWORDSMAN]Swordsmen.
				[LI] Modern: 5 [icon:UNIT_LINE_INFANTRY]Line Infantry.[/BLIST]
				[n] [n]The number of units will depend upon the number of land tiles available within the first ring including the village center.
			</Text>
		</Row>

